<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext stays off, except to this device itself: the provider settings
  accept plain HTTP only for localhost, 127.0.0.1 and ::1 (a relay or proxy
  the person runs on the phone), and without this a release build refused
  every such request at the socket, as E_COMPLETION_TRANSPORT. iOS allows the
  same through NSAllowsLocalNetworking.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
