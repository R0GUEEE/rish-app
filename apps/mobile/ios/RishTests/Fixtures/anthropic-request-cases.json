  "host_gaps": [
    {
      "host": "android",
      "what": "turns are sent as plain string content, not content blocks",
      "detail": "This host puts `{role, content: \"text\"}` on the wire where iOS puts `{role, content: [{type: text, ...}]}`. Anthropic accepts both for plain text, but a tool_use or tool_result turn has no string form, which is the same reason this host refuses a round transcript on this protocol at all. So a case replayed here feeds `body.messages` as the input: what is under test is the body around the turns, and turning turns into blocks is a layer this host does not have yet."
    },
    {
      "host": "android",
      "what": "no system block, and no tools",
      "detail": "A system turn is sent as an ordinary message rather than lifted into `system`, and tools are never translated into `input_schema` form, so an Anthropic round here cannot call one."
    }
  ]
