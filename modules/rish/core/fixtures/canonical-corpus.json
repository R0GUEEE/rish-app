  "divergences": {
    "large-fixed": {
      "stage": "parser",
      "rust_canonical": null,
      "why": "NSJSONSerialization decodes an integer lexeme beyond 64 bits as a lossy double (this text yields 123456789012345670000); the Rust core refuses such lexemes. Unreachable in practice: the strict argument parser rejects them and the engine never writes integers beyond 2^53."
    },
    "string-bom": {
      "stage": "parser",
      "rust_canonical": "\"﻿bom\"",
      "why": "NSJSONSerialization drops a U+FEFF that begins a string value (escaped or raw) while parsing; DSHWorkspaceCanonicalJSONData itself preserves U+FEFF (verified by testProbeInteriorByteOrderMark: an interior \"a\\ufeffb\" and a directly constructed NSString both keep it). serde_json keeps the character, so the Rust core canonicalises this text to \"\\ufeffbom\". Only strings that start with U+FEFF are affected."
    }
  }
